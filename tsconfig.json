{
  "compilerOptions": {
    "target": "es2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "baseUrl": ".",
    // sui-package-kit's `exports` map has no `types` condition, so "bundler"
    // resolution cannot find its declarations. Point at them directly.
    "paths": {
      "@scallop-io/sui-package-kit": [
        "./node_modules/@scallop-io/sui-package-kit"
      ]
    },
    // output .d.ts declaration files for consumers
    "declaration": true,
    "emitDeclarationOnly": true,
    // output .js.map sourcemap files for consumers
    "sourceMap": true,
    // match output dir to input dir. e.g. dist/index instead of dist/src/index
    "rootDir": ".",
    "outDir": "dist",
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": false,
    "esModuleInterop": true,
    // @mysten/sui v2 and @scallop-io/sui-kit v2 are ESM-only and expose their
    // entrypoints through the `exports` map, so `node` resolution cannot see them.
    // This also replaces the old `tsconfig-paths/register` ts-node hook, which is CJS-only.
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true
  },
  "exclude": [
    "node_modules",
    "example",
    "dist"
  ]
}
